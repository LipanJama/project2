# Database Configuration
DATABASE_URL=mysql+mysqlconnector://username:password@localhost:3306/school_erp_saas
DB_HOST=localhost
DB_PORT=3306
DB_USER=username
DB_PASSWORD=password
DB_NAME=school_erp_saas

# Security
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SaaS School ERP"
VERSION=1.0.0
DESCRIPTION="Multi-tenant School ERP System"

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://yourdomain.com"]

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourschoolerp.com
SMTP_FROM_NAME="School ERP System"

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourschoolerp.com

# WhatsApp Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Hormuud SMS Configuration (Somalia)
HORMUUD_API_URL=https://api.hormuud.com/sms
HORMUUD_API_KEY=your-hormuud-api-key
HORMUUD_SENDER_ID=your-sender-id

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Environment
ENVIRONMENT=development  # development, staging, production

# Superadmin Configuration
SUPERADMIN_EMAIL=admin@myerpsaas.com
SUPERADMIN_PASSWORD=admin123
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Multi-tenant Configuration
DEFAULT_SUBDOMAIN=admin
MAIN_DOMAIN=myerpsaas.com
TENANT_CACHE_EXPIRE=3600  # seconds

# Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 Configuration (Optional for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-s3-bucket
AWS_REGION=us-east-1

# Certificate Generation
CERTIFICATE_TEMPLATE_PATH=./templates/certificate_template.pdf
QR_CODE_BASE_URL=https://verify.yourschoolerp.com